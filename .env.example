# Copie para .env APENAS se for rodar num computador. Na hospedagem, cadastre
# estas variáveis no painel do Render (nunca coloque segredos no código).

# Segurança: o robô só funciona em modo simulado. Não mude.
PAPER_TRADING=true

# Senha para abrir o painel (escolha uma senha forte)
DASHBOARD_PASSWORD=

# Chave para assinar o login (qualquer texto longo e aleatório)
SECRET_KEY=

# Telegram (veja o README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Onde fica o banco de dados (no Render: /var/data)
DATA_DIR=data

# Opcionais (valores padrão entre parênteses)
# INITIAL_BALANCE=1000        saldo fictício inicial (1000)
# RISK_PER_TRADE=0.01         risco por operação, máx. 0.01 = 1% (0.01)
# DAILY_LOSS_LIMIT=0.03       perda máxima no dia, máx. 0.03 = 3% (0.03)
# FEE_RATE=0.001              taxa por execução (0.1%)
# SLIPPAGE_RATE=0.0005        slippage por execução (0.05%)
# ATR_STOP_MULT=1.5           stop-loss = entrada - 1,5 x ATR
# TAKE_PROFIT_R=2.0           alvo = 2 x a distância do stop
# POLL_SECONDS=20             intervalo entre ciclos
# DATA_PROVIDERS=binance,okx,coinbase   ordem das fontes de dados
# TIMEZONE=America/Sao_Paulo  fuso usado para "virar o dia"
